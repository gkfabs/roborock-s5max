<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Published S5 Max values. Units are meters and kilograms. -->
  <xacro:property name="body_length" value="0.353"/>
  <xacro:property name="body_width" value="0.350"/>
  <xacro:property name="total_height" value="0.0965"/>
  <xacro:property name="total_mass" value="3.5"/>
  <xacro:property name="body_radius" value="0.1765"/>

  <!-- Temporary geometry from photographs and related Roborock models. -->
  <!-- Replace these values after direct measurement and RViz calibration. -->
  <xacro:property name="floor_clearance" value="0.010"/>
  <xacro:property name="body_height" value="0.070"/>
  <xacro:property name="wheel_diameter" value="0.068"/>
  <xacro:property name="wheel_width" value="0.012"/>
  <xacro:property name="wheel_x" value="0.000"/>
  <xacro:property name="wheel_separation" value="0.229"/>
  <xacro:property name="caster_x" value="0.125"/>
  <xacro:property name="caster_diameter" value="0.025"/>
  <xacro:property name="lidar_x" value="0.060"/>
  <xacro:property name="lidar_y" value="0.000"/>
  <xacro:property name="lidar_diameter" value="0.075"/>
  <xacro:property name="lidar_height" value="0.0165"/>

  <!-- Dock IR receiver poses. Replace these photograph-based positions with
       direct measurements during physical calibration. -->
  <xacro:property name="dock_ir_front_x" value="0.174"/>
  <xacro:property name="dock_ir_front_y" value="0.000"/>
  <xacro:property name="dock_ir_front_yaw" value="0.000"/>
  <xacro:property name="dock_ir_right_x" value="0.124"/>
  <xacro:property name="dock_ir_right_y" value="-0.124"/>
  <xacro:property name="dock_ir_right_yaw" value="${-pi / 4}"/>

  <!-- Approximate component masses sum to the published total mass. -->
  <xacro:property name="body_mass" value="3.15"/>
  <xacro:property name="wheel_mass" value="0.10"/>
  <xacro:property name="caster_mass" value="0.05"/>
  <xacro:property name="lidar_mass" value="0.10"/>
</robot>
