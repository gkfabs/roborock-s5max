<?xml version="1.0"?>
<robot name="roborock_s5max" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="params.xacro"/>
  <xacro:include filename="inertial.xacro"/>
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="plugins.xacro"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${floor_clearance}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${body_radius}" length="${body_height}"/>
      </geometry>
      <material name="s5max_body"/>
    </visual>
    <!-- Temporary orientation marker. The orange mark points forward (+X). -->
    <visual>
      <origin xyz="${body_radius * 0.72} 0 ${body_height + 0.001}" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.012 0.002"/>
      </geometry>
      <material name="s5max_front"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${body_radius}" length="${body_height}"/>
      </geometry>
    </collision>
    <xacro:solid_cylinder_inertia mass="${body_mass}" radius="${body_radius}" length="${body_height}"/>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="${wheel_x} ${wheel_separation / 2} ${wheel_diameter / 2 - floor_clearance}" rpy="${-pi / 2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_diameter / 2}" length="${wheel_width}"/>
      </geometry>
      <material name="s5max_dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_diameter / 2}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:solid_cylinder_inertia mass="${wheel_mass}" radius="${wheel_diameter / 2}" length="${wheel_width}"/>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="${wheel_x} ${-wheel_separation / 2} ${wheel_diameter / 2 - floor_clearance}" rpy="${-pi / 2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_right_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_diameter / 2}" length="${wheel_width}"/>
      </geometry>
      <material name="s5max_dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_diameter / 2}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:solid_cylinder_inertia mass="${wheel_mass}" radius="${wheel_diameter / 2}" length="${wheel_width}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_diameter / 2 - floor_clearance}" rpy="0 0 0"/>
  </joint>
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_diameter / 2}"/>
      </geometry>
      <material name="s5max_dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_diameter / 2}"/>
      </geometry>
    </collision>
    <xacro:solid_sphere_inertia mass="${caster_mass}" radius="${caster_diameter / 2}"/>
  </link>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="${lidar_x} ${lidar_y} ${body_height + lidar_height / 2}" rpy="0 0 0"/>
  </joint>
  <link name="base_scan">
    <visual>
      <geometry>
        <cylinder radius="${lidar_diameter / 2}" length="${lidar_height}"/>
      </geometry>
      <material name="s5max_lidar"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_diameter / 2}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:solid_cylinder_inertia mass="${lidar_mass}" radius="${lidar_diameter / 2}" length="${lidar_height}"/>
  </link>

  <joint name="dock_ir_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="dock_ir_front_link"/>
    <origin xyz="${dock_ir_front_x} ${dock_ir_front_y} ${body_height / 2}" rpy="0 0 ${dock_ir_front_yaw}"/>
  </joint>
  <link name="dock_ir_front_link">
    <visual>
      <geometry>
        <box size="0.006 0.020 0.012"/>
      </geometry>
      <material name="s5max_dark_grey"/>
    </visual>
  </link>

  <joint name="dock_ir_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="dock_ir_right_link"/>
    <origin xyz="${dock_ir_right_x} ${dock_ir_right_y} ${body_height / 2}" rpy="0 0 ${dock_ir_right_yaw}"/>
  </joint>
  <link name="dock_ir_right_link">
    <visual>
      <geometry>
        <box size="0.006 0.020 0.012"/>
      </geometry>
      <material name="s5max_dark_grey"/>
    </visual>
  </link>
</robot>
