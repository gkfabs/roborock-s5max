@@ -1165,6 +1174,27 @@ def _pt_in_zones(x: float, y: float, zones) -> bool:
     return False
 
 
+def _segment_intersects_zones(x1: float, y1: float, x2: float, y2: float,
+                              zones) -> bool:
+    """Return True when a line segment crosses a no-go circle."""
+    dx = x2 - x1
+    dy = y2 - y1
+    length_sq = dx * dx + dy * dy
+    for cx, cy, radius in zones:
+        if length_sq == 0.0:
+            nearest_x, nearest_y = x1, y1
+        else:
+            projection = ((cx - x1) * dx + (cy - y1) * dy) / length_sq
+            projection = max(0.0, min(1.0, projection))
+            nearest_x = x1 + projection * dx
+            nearest_y = y1 + projection * dy
+        distance_sq = ((nearest_x - cx) ** 2
+                       + (nearest_y - cy) ** 2)
+        if distance_sq <= radius * radius:
+            return True
+    return False
+
