+    def _external_recovery_cb(self, msg: Bool) -> None:
+        active = bool(msg.data)
+        if active == self.external_recovery_active:
+            return
+        self.external_recovery_active = active
+        if active:
+            self.external_recoveries_done += 1
+            if self.external_recoveries_done > self.max_external_recoveries:
+                self._fail_job('external contact recovery limit reached')
+                return
+            pose = self._robot_pose()
+            if pose is not None:
+                rx, ry, yaw = pose
+                distance = self.robot_radius
+                cx = rx + float(np.cos(yaw)) * distance
+                cy = ry + float(np.sin(yaw)) * distance
+                if not _pt_in_zones(cx, cy, self.wedge_zones):
+                    self.wedge_zones.append(
+                        (cx, cy, self.external_contact_avoid_radius))
+            if self.cached_poses is not None \
+                    and self.wp_index < len(self.cached_poses):
+                self._external_skip_index = self.wp_index
+            if self.goal_handle is not None:
+                self._external_cancel_pending = True
+                self.goal_handle.cancel_goal_async()
+            elif self.awaiting:
+                self.cancel_on_accept = True
+            self.cmd_pub.publish(Twist())
+            self.get_logger().warn(
